# Railway MySQL plugin variables are detected automatically. These are only
# needed when your host provides a single connection URL instead.
# DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/DATABASE

# Set this to true in Railway so the login cookie is HTTPS-only.
# SESSION_COOKIE_SECURE=true

# Temporary secret for the one-time browser setup at /setup_admin.php.
# Delete this variable after creating the first admin account.
# ADMIN_SETUP_TOKEN=generate-a-long-random-secret

# Firebase: provide either the full JSON value or a path OUTSIDE the web root.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# FIREBASE_SERVICE_ACCOUNT_FILE=/secure/path/firebase-service-account.json

# Cloudflare Images. Keep the token server-side and never expose it to the app.
# CLOUDFLARE_ACCOUNT_ID=1c56e4aaed24a2a5dcb5d6926eed664
# CLOUDFLARE_IMAGES_TOKEN=your-images-write-token
# CLOUDFLARE_IMAGE_DELIVERY_BASE_URL=https://imagedelivery.net/i1S0hvdaTA--NfvhEm6LLA
# CLOUDFLARE_IMAGE_VARIANT=public

# Use these only while running `php scripts/create_admin.php`.
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=use-a-long-random-password
